:root {
  --bg: #f4f1eb;
  --paper: #faf8f4;
  --ink: #171916;
  --muted: #686861;
  --soft: #dfddd5;
  --line: #cbc8bf;
  --accent: #7b1f3a;
  --accent-dark: #571329;
  --accent-faint: #eadce0;
  --serif: "Source Serif 4", Georgia, "Times New Roman", serif;
  --sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --max: 1220px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
img { display: block; max-width: 100%; }
a { color: inherit; }
button, input { font: inherit; }
button { color: inherit; }
::selection { background: var(--accent); color: #fff; }

.wrap {
  width: min(calc(100% - 64px), var(--max));
  margin-inline: auto;
}

.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 300;
  transform: translateY(-180%);
  background: var(--ink);
  color: #fff;
  padding: 10px 14px;
  text-decoration: none;
}
.skip-link:focus { transform: translateY(0); }

/* Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(244, 241, 235, .92);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(203, 200, 191, .72);
}
.navbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}
.brand {
  flex: 0 0 auto;
  color: var(--ink);
  text-decoration: none;
  font-family: var(--serif);
  font-size: 1.18rem;
  font-weight: 650;
  letter-spacing: -.025em;
  white-space: nowrap;
}
.brand-mark { display: none; }
.navlinks {
  display: flex;
  align-items: center;
  gap: 28px;
}
.navlinks a {
  position: relative;
  color: var(--muted);
  text-decoration: none;
  font-size: .88rem;
  font-weight: 600;
  transition: color .18s ease;
}
.navlinks a:hover,
.navlinks a[aria-current="page"] { color: var(--ink); }
.navlinks a[aria-current="page"]::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -12px;
  height: 1px;
  background: var(--accent);
}
.navlinks .nav-cv {
  color: var(--accent);
  padding-left: 8px;
}
.navlinks .nav-cv::after { display: none; }
.menu-btn {
  display: none;
  border: 0;
  padding: 6px 0;
  background: transparent;
  cursor: pointer;
  color: var(--ink);
  font-size: .86rem;
  font-weight: 700;
}

/* Homepage hero */
.hero { padding: 88px 0 0; }
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(280px, .62fr);
  gap: clamp(42px, 7vw, 96px);
  align-items: end;
}
.hero-copy-column { padding-bottom: 34px; min-width: 0; }
.eyebrow,
.section-kicker {
  margin: 0;
  color: var(--accent);
  font-size: .72rem;
  line-height: 1.35;
  letter-spacing: .16em;
  text-transform: uppercase;
  font-weight: 700;
}
.hero h1,
.page-intro h1 {
  margin: 0;
  font-family: var(--serif);
  font-weight: 600;
  letter-spacing: -.055em;
  line-height: .92;
}
.hero h1 {
  margin-top: 20px;
  font-size: clamp(4.15rem, 8.4vw, 7.35rem);
  white-space: nowrap;
}
.hero-lede {
  max-width: 790px;
  margin: 34px 0 0;
  color: #31332f;
  font-family: var(--serif);
  font-size: clamp(1.35rem, 2.2vw, 1.85rem);
  line-height: 1.4;
  letter-spacing: -.015em;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
  margin-top: 34px;
}
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  text-decoration: none;
  font-size: .92rem;
  font-weight: 600;
}
.text-link span { transition: transform .18s ease; }
.text-link:hover { color: var(--accent); }
.text-link:hover span { transform: translate(2px, -2px); }
.text-link.strong { color: var(--ink); }
.text-link.strong:hover { color: var(--accent); }

.portrait-figure { margin: 0; min-width: 0; }
.portrait-frame {
  position: relative;
  width: min(100%, 360px);
  margin-left: auto;
  padding: 0 0 18px 18px;
}
.portrait-frame::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 64%;
  height: 72%;
  border-left: 1px solid var(--accent);
  border-bottom: 1px solid var(--accent);
  pointer-events: none;
}
.portrait-frame::after {
  content: "";
  position: absolute;
  z-index: -1;
  top: -22px;
  right: -20px;
  width: 62%;
  height: 54%;
  background: var(--accent-faint);
}
.profile-image {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center top;
  filter: saturate(.86) contrast(1.03);
}
.portrait-figure figcaption {
  width: min(100%, 342px);
  margin: 14px 0 0 auto;
  display: grid;
  gap: 2px;
  color: var(--muted);
  font-size: .78rem;
  line-height: 1.45;
}
.portrait-figure figcaption span:first-child { color: var(--ink); font-weight: 650; }

.hero-note {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 48px;
  align-items: end;
  padding-top: 42px;
  padding-bottom: 36px;
  border-top: 1px solid var(--line);
}
.hero-note p {
  max-width: 870px;
  margin: 0;
  color: var(--muted);
  font-size: .96rem;
}
.hero-location {
  color: var(--muted);
  font-size: .78rem;
  white-space: nowrap;
}

/* Metrics */
.metrics { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
.metric {
  display: flex;
  align-items: baseline;
  gap: 12px;
  min-height: 104px;
  padding: 28px 26px;
}
.metric:first-child { padding-left: 0; }
.metric + .metric { border-left: 1px solid var(--line); }
.metric strong {
  flex: 0 0 auto;
  font-family: var(--serif);
  font-size: 2.45rem;
  line-height: 1;
  font-weight: 600;
  letter-spacing: -.05em;
}
.metric span { color: var(--muted); font-size: .78rem; line-height: 1.35; }

/* Shared sections */
.section { padding: 86px 0; }
.section.border-top { border-top: 1px solid var(--line); }
.editorial-grid,
.section-head {
  display: grid;
  grid-template-columns: minmax(150px, .34fr) minmax(0, 1fr);
  gap: clamp(34px, 7vw, 100px);
  align-items: start;
}
.section-head { margin-bottom: 42px; }
.section-title {
  max-width: 850px;
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(2.3rem, 4.8vw, 4.4rem);
  line-height: 1.02;
  font-weight: 600;
  letter-spacing: -.045em;
}
.section-copy { max-width: 720px; margin: 18px 0 0; color: var(--muted); }

.focus-lines { margin-top: 54px; border-top: 1px solid var(--line); }
.focus-line {
  display: grid;
  grid-template-columns: minmax(230px, .75fr) minmax(0, 1fr);
  gap: 42px;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
}
.focus-line h3 {
  margin: 0;
  font-family: var(--serif);
  font-size: 1.45rem;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: -.02em;
}
.focus-line p { max-width: 610px; margin: 0; color: var(--muted); font-size: .93rem; }
.focus-num { display: none; }

.selected-list { border-top: 1px solid var(--line); }
.selected-item {
  display: grid;
  grid-template-columns: 70px minmax(0, 1fr) 24px;
  gap: 18px;
  align-items: start;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
  text-decoration: none;
}
.selected-year { color: var(--accent); font-family: var(--serif); font-weight: 650; }
.selected-main { display: grid; gap: 6px; }
.selected-main strong {
  font-family: var(--serif);
  font-size: 1.22rem;
  line-height: 1.38;
  font-weight: 600;
  letter-spacing: -.012em;
}
.selected-main small { color: var(--muted); font-size: .83rem; }
.selected-arrow { color: var(--muted); transition: transform .18s ease, color .18s ease; }
.selected-item:hover .selected-main strong { color: var(--accent); }
.selected-item:hover .selected-arrow { color: var(--accent); transform: translate(3px, -3px); }
.section-cta { margin-top: 26px; }

.explore-list { border-top: 1px solid var(--line); }
.explore-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 27px 0;
  border-bottom: 1px solid var(--line);
  text-decoration: none;
}
.explore-row > span:first-child { display: grid; grid-template-columns: minmax(150px, .45fr) minmax(0, 1fr); gap: 34px; align-items: baseline; flex: 1; }
.explore-row strong { font-family: var(--serif); font-size: 1.75rem; font-weight: 600; letter-spacing: -.025em; }
.explore-row small { color: var(--muted); font-size: .87rem; }
.explore-row > span:last-child { color: var(--muted); transition: transform .18s ease, color .18s ease; }
.explore-row:hover strong,
.explore-row:hover > span:last-child { color: var(--accent); }
.explore-row:hover > span:last-child { transform: translate(3px, -3px); }

/* Secondary page intro */
.page-intro {
  padding: 96px 0 58px;
  border-bottom: 1px solid var(--line);
}
.page-intro-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, .62fr);
  gap: 70px;
  align-items: end;
}
.page-intro .eyebrow { margin-bottom: 20px; }
.page-intro h1 { font-size: clamp(4.5rem, 9vw, 8rem); }
.page-intro p { margin: 0 0 7px; color: var(--muted); font-size: .95rem; }
.page-intro p a { color: var(--ink); text-decoration-color: var(--line); text-underline-offset: 4px; }
.page-intro p a:hover { color: var(--accent); }

/* Research */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 44px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line);
}
.filter-btn {
  border: 0;
  border-bottom: 1px solid transparent;
  background: transparent;
  padding: 0 0 6px;
  cursor: pointer;
  color: var(--muted);
  font-size: .82rem;
  font-weight: 650;
}
.filter-btn:hover { color: var(--ink); }
.filter-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
.research-group { margin-top: 64px; }
.research-group:first-of-type { margin-top: 0; }
.research-group.is-hidden { display: none; }
.group-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--ink);
}
.group-head h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: 2rem;
  line-height: 1.15;
  font-weight: 600;
  letter-spacing: -.03em;
}
.group-head span { color: var(--muted); font-size: .76rem; }
.pub-list { list-style: none; margin: 0; padding: 0; }
.pub-item {
  display: grid;
  grid-template-columns: 74px minmax(0, 1fr) minmax(90px, auto);
  gap: 24px;
  align-items: start;
  padding: 26px 0;
  border-bottom: 1px solid var(--line);
}
.pub-year { color: var(--accent); font-family: var(--serif); font-size: 1rem; font-weight: 650; }
.pub-title { margin: 0; font-family: var(--serif); font-size: 1.22rem; line-height: 1.4; font-weight: 600; letter-spacing: -.012em; }
.pub-meta { margin: 7px 0 0; color: var(--muted); font-size: .86rem; }
.pub-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: end; }
.pub-link,
.cite-btn {
  border: 0;
  background: transparent;
  padding: 2px 0;
  color: var(--muted);
  text-decoration: none;
  font-size: .76rem;
  font-weight: 650;
  cursor: pointer;
}
.pub-link:hover, .cite-btn:hover { color: var(--accent); }
.status-tag {
  display: inline-block;
  margin-top: 9px;
  color: var(--accent);
  font-size: .75rem;
  font-weight: 650;
}
.status-tag::before { content: "— "; }

/* Education */
.timeline { max-width: 980px; }
.timeline::before { display: none; }
.edu-item {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: 50px;
  padding: 34px 0;
  border-top: 1px solid var(--line);
}
.edu-item:last-child { border-bottom: 1px solid var(--line); }
.edu-item::before { display: none; }
.edu-years { color: var(--accent); font-family: var(--serif); font-size: 1rem; font-weight: 650; }
.edu-body h2 { margin: 0; font-family: var(--serif); font-size: 1.8rem; line-height: 1.2; font-weight: 600; letter-spacing: -.025em; }
.edu-body p { margin: 8px 0 0; color: var(--muted); font-size: .91rem; }
.method-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.content-card { background: transparent; }
.method-card { padding: 28px 34px 30px 0; }
.method-card + .method-card { padding-left: 34px; border-left: 1px solid var(--line); }
.method-card h3 { margin: 0 0 10px; font-family: var(--serif); font-size: 1.55rem; font-weight: 600; }
.method-card p { margin: 0; color: var(--muted); }

/* Teaching */
.teaching-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 52px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.teaching-stat { padding: 26px 30px; }
.teaching-stat:first-child { padding-left: 0; }
.teaching-stat + .teaching-stat { border-left: 1px solid var(--line); }
.teaching-stat strong { display: block; font-family: var(--serif); font-size: 2.45rem; line-height: 1; font-weight: 600; letter-spacing: -.045em; }
.teaching-stat span { display: block; margin-top: 9px; color: var(--muted); font-size: .8rem; }
.table-wrap { overflow-x: auto; border-top: 1px solid var(--ink); }
table { width: 100%; min-width: 780px; border-collapse: collapse; }
th {
  padding: 13px 14px;
  color: var(--muted);
  text-align: left;
  font-size: .7rem;
  letter-spacing: .09em;
  text-transform: uppercase;
  font-weight: 700;
}
td { padding: 17px 14px; border-top: 1px solid var(--line); vertical-align: top; font-size: .86rem; }
td:first-child, th:first-child { padding-left: 0; }
td:last-child, th:last-child { padding-right: 0; text-align: right; }
tr.is-hidden { display: none; }
.role-label { color: var(--accent); font-weight: 650; }
.role-label.ta { color: var(--muted); }
.table-note { margin: 12px 0 0; color: var(--muted); font-size: .76rem; }

.quote-panel {
  position: relative;
  display: grid;
  grid-template-columns: 84px minmax(0, 1fr);
  gap: 26px;
  padding: 12px 0 34px;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--line);
}
.quote-mark { color: var(--accent); font-family: var(--serif); font-size: 5.8rem; line-height: .8; }
.quote-text { max-width: 820px; margin: 0; font-family: var(--serif); font-size: clamp(1.7rem, 3.4vw, 2.8rem); line-height: 1.25; font-weight: 500; letter-spacing: -.025em; }
.quote-meta { margin-top: 18px; color: var(--muted); font-size: .78rem; }
.quote-controls { display: flex; align-items: center; gap: 12px; margin-top: 24px; }
.quote-btn {
  width: 34px;
  height: 34px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
}
.quote-btn:hover { border-color: var(--accent); color: var(--accent); }
.quote-count { color: var(--muted); font-size: .75rem; }
.quote-list { columns: 2; column-gap: 44px; margin-top: 30px; border-top: 1px solid var(--line); }
.quote-list blockquote {
  break-inside: avoid;
  margin: 0;
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.55;
}
.quote-list.is-hidden { display: none; }
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-bottom: 1px solid var(--ink);
  background: transparent;
  padding: 8px 0 5px;
  color: var(--ink);
  text-decoration: none;
  font-size: .82rem;
  font-weight: 650;
  cursor: pointer;
}
.btn:hover { color: var(--accent); border-color: var(--accent); }
.show-all-btn { margin-top: 20px; }

/* Footer */
.site-footer { margin-top: 48px; border-top: 1px solid var(--ink); }
.footer-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 40px;
  padding: 46px 0 38px;
  align-items: end;
}
.footer-title { margin: 0; font-family: var(--serif); font-size: 1.55rem; font-weight: 600; letter-spacing: -.02em; }
.footer-sub { margin: 6px 0 0; color: var(--muted); font-size: .83rem; }
.footer-links { display: flex; flex-wrap: wrap; justify-content: end; gap: 18px; }
.footer-links a { color: var(--muted); text-decoration: none; font-size: .78rem; font-weight: 600; }
.footer-links a:hover { color: var(--accent); }
.footer-bottom { padding: 16px 0 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; }

.toast {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 150;
  padding: 10px 14px;
  background: var(--ink);
  color: #fff;
  font-size: .78rem;
  opacity: 0;
  transform: translateY(10px);
  pointer-events: none;
  transition: opacity .2s ease, transform .2s ease;
}
.toast.show { opacity: 1; transform: none; }

@media (max-width: 980px) {
  .wrap { width: min(calc(100% - 44px), var(--max)); }
  .hero { padding-top: 66px; }
  .hero-grid { grid-template-columns: minmax(0, 1fr) 290px; gap: 42px; }
  .hero h1 { font-size: clamp(3.75rem, 8.7vw, 6rem); }
  .metric { display: block; }
  .metric span { display: block; margin-top: 8px; }
  .editorial-grid, .section-head { grid-template-columns: 140px minmax(0, 1fr); gap: 44px; }
  .page-intro-grid { grid-template-columns: 1fr .62fr; gap: 42px; }
  .pub-item { grid-template-columns: 62px minmax(0, 1fr); }
  .pub-links { grid-column: 2; justify-content: start; }
}

@media (max-width: 760px) {
  .wrap { width: min(calc(100% - 30px), var(--max)); }
  .navbar { min-height: 66px; }
  .menu-btn { display: block; }
  .navlinks {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    display: none;
    padding: 14px 15px 18px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }
  .navlinks.open { display: flex; }
  .navlinks a { padding: 11px 0; border-bottom: 1px solid var(--line); }
  .navlinks a[aria-current="page"]::after { display: none; }
  .navlinks .nav-cv { padding-left: 0; border-bottom: 0; }

  .hero { padding-top: 48px; }
  .hero-grid { grid-template-columns: 1fr; gap: 50px; }
  .hero-copy-column { padding-bottom: 0; }
  .hero h1 { font-size: clamp(2.7rem, 13.8vw, 5rem); }
  .hero-lede { margin-top: 26px; }
  .portrait-frame { width: min(78vw, 350px); margin-left: 0; }
  .portrait-figure figcaption { width: min(78vw, 332px); margin-left: 18px; }
  .hero-note { grid-template-columns: 1fr; gap: 14px; padding-top: 32px; }

  .metrics-grid { grid-template-columns: 1fr 1fr; }
  .metric { min-height: 94px; padding: 24px 18px; }
  .metric:first-child { padding-left: 0; }
  .metric:nth-child(3) { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  .metric:nth-child(4) { border-top: 1px solid var(--line); }

  .section { padding: 64px 0; }
  .editorial-grid, .section-head { grid-template-columns: 1fr; gap: 22px; }
  .section-head { margin-bottom: 34px; }
  .focus-lines { margin-top: 36px; }
  .focus-line { grid-template-columns: 1fr; gap: 10px; }
  .explore-row > span:first-child { grid-template-columns: 1fr; gap: 4px; }

  .page-intro { padding: 62px 0 42px; }
  .page-intro-grid { grid-template-columns: 1fr; gap: 30px; }
  .page-intro h1 { font-size: clamp(4rem, 19vw, 6rem); }

  .edu-item { grid-template-columns: 1fr; gap: 8px; padding: 26px 0; }
  .method-grid { grid-template-columns: 1fr; }
  .method-card { padding: 26px 0; }
  .method-card + .method-card { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }

  .teaching-stats { grid-template-columns: 1fr; }
  .teaching-stat { padding: 21px 0; }
  .teaching-stat + .teaching-stat { border-left: 0; border-top: 1px solid var(--line); }
  .quote-panel { grid-template-columns: 54px minmax(0, 1fr); gap: 14px; }
  .quote-mark { font-size: 4.7rem; }
  .quote-list { columns: 1; }

  .footer-grid { grid-template-columns: 1fr; align-items: start; }
  .footer-links { justify-content: start; }
}

@media (max-width: 520px) {
  .hero h1 { font-size: clamp(2.45rem, 13.6vw, 4rem); letter-spacing: -.06em; }
  .hero-actions { gap: 20px; }
  .metrics-grid { grid-template-columns: 1fr; }
  .metric, .metric:nth-child(3), .metric:nth-child(4) { padding: 20px 0; border-left: 0; border-top: 1px solid var(--line); }
  .metric:first-child { border-top: 0; }
  .selected-item { grid-template-columns: 54px minmax(0, 1fr) 18px; gap: 12px; }
  .selected-main strong { font-size: 1.08rem; }
  .pub-item { grid-template-columns: 1fr; gap: 7px; }
  .pub-links { grid-column: 1; }
  .group-head { align-items: start; flex-direction: column; gap: 5px; }
  .quote-panel { grid-template-columns: 1fr; }
  .quote-mark { height: 38px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition: none !important; }
}

@media print {
  .site-header, .filters, .quote-controls, .show-all-btn, .footer-links, .toast { display: none !important; }
  body { background: #fff; }
  .wrap { width: 100%; }
  .research-group.is-hidden, tr.is-hidden, .quote-list.is-hidden { display: block !important; }
  tr.is-hidden { display: table-row !important; }
}

/* =========================================================
   Home v2: restrained academic homepage
   ========================================================= */
.home-v2 {
  --home-bg: #fbfaf7;
  --home-ink: #20211f;
  --home-muted: #696a65;
  --home-line: #d9d7d0;
  --home-accent: #6f1d36;
  background: var(--home-bg);
}
.home-v2 .site-header {
  background: rgba(251, 250, 247, .94);
  border-bottom-color: var(--home-line);
}
.home-v2 .home-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--home-ink);
  border-radius: 50%;
  color: var(--home-ink);
  text-decoration: none;
  font-family: var(--serif);
  font-size: .92rem;
  font-weight: 600;
  letter-spacing: -.03em;
}
.home-v2 .navlinks a[aria-current="page"]::after { background: var(--home-accent); }
.home-v2 .navlinks .nav-cv { color: var(--home-accent); }

.scholar-hero { padding: 82px 0 76px; }
.scholar-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: clamp(58px, 9vw, 132px);
  align-items: start;
}
.scholar-intro { padding-top: 20px; }
.scholar-role {
  margin: 0 0 14px;
  color: var(--home-accent);
  font-size: .82rem;
  font-weight: 600;
  letter-spacing: .015em;
}
.scholar-intro h1 {
  margin: 0;
  color: var(--home-ink);
  font-family: var(--serif);
  font-size: clamp(3.3rem, 5.7vw, 5.2rem);
  line-height: .98;
  font-weight: 500;
  letter-spacing: -.045em;
  white-space: nowrap;
}
.scholar-affiliation {
  margin: 15px 0 0;
  color: var(--home-muted);
  font-size: .98rem;
  font-weight: 500;
}
.scholar-bio {
  max-width: 700px;
  margin: 38px 0 0;
  color: var(--home-ink);
  font-family: var(--serif);
  font-size: clamp(1.22rem, 1.8vw, 1.47rem);
  line-height: 1.56;
  letter-spacing: -.012em;
}
.scholar-bio.secondary {
  margin-top: 18px;
  color: var(--home-muted);
  font-family: var(--sans);
  font-size: .95rem;
  line-height: 1.7;
}
.scholar-links {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 32px;
}
.scholar-links a,
.scholar-more,
.home-academic-grid a {
  color: var(--home-ink);
  text-underline-offset: 4px;
  text-decoration-thickness: 1px;
  font-size: .87rem;
  font-weight: 600;
}
.scholar-links a:hover,
.scholar-more:hover,
.home-academic-grid a:hover { color: var(--home-accent); }

.scholar-photo { margin: 0; }
.scholar-photo-media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #ece9e2;
}
.scholar-photo-media img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  filter: saturate(.92) contrast(1.015);
}
.photo-fallback {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #e8e4dc, #f4f1eb);
  color: #7b7972;
  font-family: var(--serif);
}
.photo-fallback span {
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  border: 1px solid #aaa69c;
  border-radius: 50%;
  font-size: 1.7rem;
  letter-spacing: -.04em;
}
.scholar-photo figcaption {
  margin-top: 13px;
  color: var(--home-muted);
  font-size: .75rem;
  line-height: 1.55;
}

.scholar-section { border-top: 1px solid var(--home-line); }
.scholar-two-col {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: clamp(44px, 8vw, 112px);
  padding-top: 54px;
  padding-bottom: 54px;
}
.scholar-label {
  padding-top: 2px;
  color: var(--home-muted);
  font-size: .76rem;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
}
.scholar-interest-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 46px;
}
.scholar-interest-list p {
  margin: 0;
  padding: 13px 0;
  border-bottom: 1px solid var(--home-line);
  color: var(--home-ink);
  font-family: var(--serif);
  font-size: 1.18rem;
}
.scholar-interest-list p:nth-child(-n+2) { border-top: 1px solid var(--home-line); }

.scholar-copy-list { border-top: 1px solid var(--home-line); }
.scholar-copy-list article {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: 34px;
  padding: 24px 0;
  border-bottom: 1px solid var(--home-line);
}
.scholar-copy-list h2,
.home-academic-grid h2 {
  margin: 0;
  color: var(--home-ink);
  font-family: var(--serif);
  font-size: 1.2rem;
  line-height: 1.35;
  font-weight: 500;
}
.scholar-copy-list p,
.home-academic-grid p {
  max-width: 680px;
  margin: 0;
  color: var(--home-muted);
  font-size: .92rem;
  line-height: 1.7;
}

.plain-publication-list { border-top: 1px solid var(--home-line); }
.plain-publication-list a {
  display: grid;
  grid-template-columns: 62px minmax(0, 1fr);
  gap: 24px;
  padding: 22px 0;
  border-bottom: 1px solid var(--home-line);
  color: inherit;
  text-decoration: none;
}
.pub-home-year {
  padding-top: 2px;
  color: var(--home-muted);
  font-size: .78rem;
}
.plain-publication-list strong {
  display: block;
  color: var(--home-ink);
  font-family: var(--serif);
  font-size: 1.16rem;
  line-height: 1.42;
  font-weight: 500;
  transition: color .15s ease;
}
.plain-publication-list small {
  display: block;
  margin-top: 6px;
  color: var(--home-muted);
  font-size: .77rem;
  line-height: 1.45;
}
.plain-publication-list a:hover strong { color: var(--home-accent); }
.scholar-more { display: inline-block; margin-top: 22px; }

.home-academic-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
}
.home-academic-grid > div { border-top: 1px solid var(--home-line); padding-top: 20px; }
.home-academic-grid p { margin-top: 9px; }
.home-academic-grid a { display: inline-block; margin-top: 16px; }
.scholar-last .scholar-two-col { padding-bottom: 80px; }

.home-footer { margin-top: 0; border-top-color: var(--home-ink); }
.home-v2 .footer-grid { padding-top: 38px; padding-bottom: 30px; }
.home-v2 .footer-title { font-size: 1.22rem; }

@media (max-width: 880px) {
  .scholar-hero { padding-top: 62px; }
  .scholar-hero-grid { grid-template-columns: minmax(0, 1fr) 240px; gap: 46px; }
  .scholar-two-col { grid-template-columns: 145px minmax(0, 1fr); gap: 40px; }
  .scholar-copy-list article { grid-template-columns: 150px minmax(0, 1fr); }
}

@media (max-width: 700px) {
  .home-v2 .home-mark { width: 34px; height: 34px; }
  .scholar-hero { padding: 48px 0 54px; }
  .scholar-hero-grid { grid-template-columns: 1fr; gap: 44px; }
  .scholar-intro { padding-top: 0; }
  .scholar-intro h1 { font-size: clamp(2.8rem, 13vw, 4.25rem); white-space: nowrap; }
  .scholar-bio { margin-top: 30px; }
  .scholar-photo { width: min(74vw, 300px); }
  .scholar-two-col { grid-template-columns: 1fr; gap: 22px; padding-top: 42px; padding-bottom: 42px; }
  .scholar-interest-list { grid-template-columns: 1fr; }
  .scholar-interest-list p:first-child { border-top: 1px solid var(--home-line); }
  .scholar-interest-list p:nth-child(2) { border-top: 0; }
  .scholar-copy-list article { grid-template-columns: 1fr; gap: 7px; }
  .home-academic-grid { grid-template-columns: 1fr; gap: 34px; }
  .scholar-last .scholar-two-col { padding-bottom: 56px; }
}

@media (max-width: 430px) {
  .scholar-intro h1 { font-size: clamp(2.45rem, 12.6vw, 3.35rem); }
  .plain-publication-list a { grid-template-columns: 46px minmax(0, 1fr); gap: 15px; }
  .scholar-links { gap: 16px 20px; }
}
